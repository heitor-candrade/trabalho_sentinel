# Operacao Sentinel - variaveis do ambiente (copiado para .env pelo scripts/setup.sh)
# Porta do Nginx publicada no host (unica porta de usuario). Mude se 8080 estiver ocupada.
HOST_PORT=8080
# Prefixo da sub-rede do projeto (rede ${NET_PREFIX}.0/24, IPs fixos .10 nginx, .11 rust-a, .12 rust-b,
# .20 watchdog, .30 prometheus, .40 toolbox, .41 trafego, .50 painel). Mude se houver conflito com VPN/outra rede.
NET_PREFIX=10.9.8
# Porta do painel (publicada so em 127.0.0.1).
PAINEL_PORT=8085
